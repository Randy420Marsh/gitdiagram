# GitDiagram local mode (LOCAL.md). run.bat / run.sh copy this to .env.local
# on first run; edit .env.local, not this file.

# Diagrams are stored under .local-data/ and Redis runs inside the server:
# no R2, Upstash, OpenAI or OpenRouter account is needed.
GITDIAGRAM_LOCAL=1
NEXT_PUBLIC_GITDIAGRAM_LOCAL=1

# The model: any llama-server (llama.cpp) with the Responses API. Structured
# graph output needs a build that maps text.format to response_format (the
# video-audio-pipeline fork of llama.cpp has it).
AI_PROVIDER=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# Only matters in llama-server router mode (several models behind one port).
# LOCAL_LLM_MODEL=
# Only when llama-server was started with --api-key.
# LOCAL_LLM_API_KEY=
# app     = GitDiagram's per-stage effort (low/medium), mapped to the model's own
#           levels from /props (Qwen3.8: low / medium / xhigh)
# xhigh   = one fixed level for every request (any level the model reports)
# default = send none; the chat template's default applies
LOCAL_LLM_REASONING_EFFORT=app
# How long one model request may take, in milliseconds (default 600000).
# LOCAL_LLM_TIMEOUT_MS=600000

# Folders whose direct sub-folders open as http://localhost:3000/local/<name>
# (several: separate with ; on Windows, : on Linux). Git folders list what
# `git ls-files` lists, so .gitignore is honored.
# LOCAL_REPO_ROOTS=C:\Projects;D:\Code
LOCAL_REPO_ROOTS=

# Where diagrams and the per-install secret are kept (default .local-data).
# LOCAL_DATA_DIR=

# OPTIONAL: GitHub repositories still work (public ones without a token);
# a token raises GitHub's rate limit.
# GITHUB_PAT=
